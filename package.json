{
  "name": "cue-craft-billiard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:constraint": "tsx scripts/test-double-booking.ts",
    "test:flow": "tsx scripts/test-flow.ts",
    "test:routes": "tsx scripts/test-routes.ts",
    "test:counter": "tsx scripts/test-counter.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:constraint && npm run test:flow && npm run test:routes && npm run test:counter",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:start": "powershell -ExecutionPolicy Bypass -File scripts/pg.ps1 -Action start",
    "db:stop": "powershell -ExecutionPolicy Bypass -File scripts/pg.ps1 -Action stop",
    "db:status": "powershell -ExecutionPolicy Bypass -File scripts/pg.ps1 -Action status"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
