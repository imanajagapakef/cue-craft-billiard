# Normalise line endings so diffs stay readable across Windows and CI.
* text=auto

*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.prisma text eol=lf
*.sql  text eol=lf

*.png  binary
*.jpg  binary
*.webp binary
*.ico  binary
